{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#11.0.0", ":disableDependencyDashboard"],
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      description: ["Keep the Go toolchain in step across mise.toml, go.mod and the build image"],
      matchDepNames: ["go", "golang"],
      groupName: "go",
    },
    {
      description: ["Pin Dockerfile base images by digest, like the GitHub Actions"],
      matchDatasources: ["docker"],
      matchFileNames: ["Dockerfile"],
      pinDigests: true,
    },
    {
      description: [
        "Auto-merge non-major updates once CI passes; each merge publishes a new rolling image for the homelab to pick up",
        "0.x versions are excluded because their minors can break (see the presets' zer0ver rules)",
      ],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
    },
  ],
}
